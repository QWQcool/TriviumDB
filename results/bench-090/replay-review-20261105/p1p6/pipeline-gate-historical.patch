+/// 内容签名：按 id 排序后折叠 (id, similarity, property_score)。
+/// 0.9.0 的两个物理计划会写出不同的 provenance 元数据（property_origin/source_ids），
+/// 直接用 NodeSet 全等比较会误判为"结果不一致"，故这里只校验结果内容。
+fn content_signature(set: &NodeSet) -> u64 {
+    let mut rows: Vec<_> = set.rows().iter().collect();
+    rows.sort_by_key(|row| row.id);
+    rows.iter()
+        .fold(0xcbf29ce484222325u64, |hash, row| {
+            let mut h = hash.wrapping_mul(0x100000001b3) ^ row.id;
+            h = h.wrapping_mul(0x100000001b3)
+                ^ row.similarity.map_or(0, |score| score.value.to_bits() as u64);
+            h = h.wrapping_mul(0x100000001b3)
+                ^ row.property_score.map_or(0, |score| score.value.to_bits() as u64);
+            h
+        })
+}
