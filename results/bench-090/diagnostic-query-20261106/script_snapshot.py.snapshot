"""Pre-registered, diagnostic-only investigation of Cohere ANN timing variance.

This does not modify the benchmark, the official protocol, or a published
summary. It writes to a new directory only. Run --self-test for a tiny
synthetic test; actual collection requires --output and performs six builds.
"""
from __future__ import annotations

import argparse
import ctypes
import hashlib
import json
import math
import os
import re
import statistics
import subprocess
import sys
import tempfile
import threading
import time
from ctypes import wintypes
from datetime import datetime, timezone
from pathlib import Path

import replay_complete as runner
import replay_continue_v3 as job_api


ROOT = Path(__file__).resolve().parents[2]
RESULT_ROOT = (ROOT / 'results' / 'bench-090').resolve()
WORKTREE = ROOT / '.bench090'
SOURCE = ROOT / 'results' / 'bench-090' / 'replay-20261105' / 'manifest.json'
BOUND_HASHES = ROOT / 'results' / 'bench-090' / 'replay-full-v3-20261105' / 'input_hashes_after.json'
REVISION = '7edf8ceacd85cd71944a3471ac05df377995a172'
SEQUENCE = ['A', 'B', 'B', 'A', 'A', 'B']
EFS = [10, 25, 30, 35, 40]
REPEATS = 10
EF_SEQUENCE = EFS * REPEATS
MIB = 1 << 20
RAW_LINE = re.compile(r'^ef=\s*(\d+)\s')


def now():
    return datetime.now(timezone.utc).isoformat(timespec='microseconds')


def dump_new(path, value):
    with path.open('x', encoding='utf-8', newline='\n') as f:
        json.dump(value, f, ensure_ascii=False, indent=2)
        f.write('\n')


def sha256(path):
    digest = hashlib.sha256()
    with path.open('rb') as src:
        for block in iter(lambda: src.read(4 * MIB), b''):
            digest.update(block)
    return digest.hexdigest()


def describe(path):
    stat = path.stat()
    return {'path': str(path), 'bytes': stat.st_size, 'mtime_ns': stat.st_mtime_ns,
            'sha256': sha256(path)}


def verify_code(paths, expected):
    current = {key: sha256(path) for key, path in paths.items()}
    if current != expected:
        changed = [key for key in current if current[key] != expected.get(key)]
        raise RuntimeError(f'code or bound evidence changed during diagnostic: {changed}')
    return current


def worktree_diff_hash():
    diff = subprocess.run(['git', 'diff', '--binary', 'HEAD'], cwd=WORKTREE,
                          check=True, capture_output=True).stdout
    return hashlib.sha256(diff).hexdigest()


def make_repeated(source, target, copies, expected_sha):
    """Create new data exclusively, then hash each segment and entire result."""
    length = source.stat().st_size
    with target.open('xb') as out:
        for _ in range(copies):
            digest = hashlib.sha256()
            with source.open('rb') as src:
                for block in iter(lambda: src.read(4 * MIB), b''):
                    digest.update(block)
                    out.write(block)
            if digest.hexdigest() != expected_sha:
                raise RuntimeError(f'source changed while copying: {source}')
        out.flush()
        os.fsync(out.fileno())
    segment_hashes = []
    with target.open('rb') as result:
        for _ in range(copies):
            digest = hashlib.sha256()
            remaining = length
            while remaining:
                block = result.read(min(4 * MIB, remaining))
                if not block:
                    raise RuntimeError('incomplete repeated file')
                digest.update(block)
                remaining -= len(block)
            segment_hashes.append(digest.hexdigest())
        if result.read(1):
            raise RuntimeError('unexpected extra data in repeated file')
    if segment_hashes != [expected_sha] * copies:
        raise RuntimeError(f'repeated content mismatch: {target}')
    stat = target.stat()
    return {'file': target.name, 'bytes': stat.st_size, 'mtime_ns': stat.st_mtime_ns,
            'sha256': sha256(target), 'segment_sha256': segment_hashes}


def verify_generated(data_dir, expected):
    """Reject changed generated inputs before/after use; retain snapshots."""
    current = {}
    for key, expected_item in expected.items():
        path = data_dir / expected_item['file']
        data = describe(path)
        current[key] = data
        if any(data[k] != expected_item[k] for k in ('bytes', 'mtime_ns', 'sha256')):
            raise RuntimeError(f'generated diagnostic input changed: {key}')
    return current


def resource_gate(path, train_bytes, max_wait):
    minimum = 3 * train_bytes + 8 * (1 << 30)
    deadline = time.monotonic() + max_wait
    while True:
        samples = [runner.cpu_percent(1) for _ in range(3)]
        mem = runner.memory_snapshot()
        passed = max(samples) < 15 and mem['available_bytes'] >= minimum
        runner.append_event(path, {'at': now(), 'cpu_percent_samples': samples,
                                   **mem, 'required_available_bytes': minimum,
                                   'passed': passed})
        if passed:
            return
        if time.monotonic() >= deadline:
            raise RuntimeError('resource gate timed out; run was not launched')
        time.sleep(15)


def sensors():
    """Keep optional Windows raw readings; ACPI zones are not calibrated CPU T."""
    ps = r'''
$ErrorActionPreference='Stop'
$c = @(); $t = @(); $cpus = @(); $errors = @()
$paths = @('\Processor Information(_Total)\% Processor Performance','\Processor Information(_Total)\Actual Frequency','\Processor Information(_Total)\Processor Frequency')
foreach ($path in $paths) {
  try { $item = (Get-Counter -Counter $path -SampleInterval 1 -MaxSamples 1).CounterSamples[0]; $c += @{path=$path;available=$true;value=$item.CookedValue} }
  catch { $errors += ($path + ': ' + $_.Exception.Message); $c += @{path=$path;available=$false;value=$null} }
}
try { $cpus = @(Get-CimInstance Win32_Processor | Select-Object Name,CurrentClockSpeed,MaxClockSpeed) } catch { $errors += $_.Exception.Message }
try { $t = @(Get-CimInstance -Namespace root/wmi -ClassName MSAcpi_ThermalZoneTemperature | Select-Object InstanceName,CurrentTemperature) } catch { $errors += $_.Exception.Message }
@{processor_counter_samples=$c; processor_cim=$cpus; acpi_thermal_zones_raw=$t; errors=$errors} | ConvertTo-Json -Depth 5 -Compress
'''
    begin = time.monotonic()
    try:
        p = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', ps],
                           capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=25)
        return {'at': now(), 'wall_seconds': time.monotonic() - begin, 'exit_code': p.returncode,
                'raw_stdout': p.stdout, 'stderr': p.stderr,
                'limitation': 'ACPI zones are raw/unvalidated, not guaranteed CPU package temperature; frequency/clock counters are reported raw and may not represent instantaneous CPU-core frequency.'}
    except Exception as exc:
        return {'at': now(), 'wall_seconds': time.monotonic() - begin, 'error': repr(exc)}


def monitored_process(command, cwd, env, folder, timeout):
    """Contain the benchmark in a Job; buffer samples until after measurements."""
    output = bytearray()
    line_events, telemetry, errors = [], [], []
    job = job_api.create_job()
    proc = None
    assigned = False
    stop = threading.Event()
    reader = monitor = None
    started = time.monotonic()
    trace = {'started_at': now(), 'command': [str(x) for x in command],
             'timeout_seconds': timeout, 'reason': None}

    def read_stdout():
        try:
            for line in iter(proc.stdout.readline, b''):
                output.extend(line)
                text = line.decode('utf-8', errors='replace').rstrip('\r\n')
                match = RAW_LINE.match(text)
                if match:
                    line_events.append({'arrival_utc': now(), 'monotonic_seconds': time.monotonic(),
                                        'ef': int(match.group(1)), 'line': text})
        except Exception as exc:
            errors.append('stdout reader: ' + repr(exc))

    def sample():
        try:
            while not stop.is_set():
                before = time.monotonic()
                process_cpu_before = time.process_time()
                cpu = runner.cpu_percent(1)
                accounting = job_api.job_accounting(job)
                telemetry.append({'at': now(), 'monotonic_seconds': time.monotonic(),
                                  'total_system_cpu_percent': cpu, **runner.memory_snapshot(),
                                  'job_accounting': accounting,
                                  'observer_process_cpu_seconds': time.process_time() - process_cpu_before,
                                  'sample_wall_seconds': time.monotonic() - before})
        except Exception as exc:
            errors.append('monitor: ' + repr(exc))

    try:
        proc = subprocess.Popen([str(x) for x in command], cwd=str(cwd), env=env,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                creationflags=0x00000004)
        if not job_api.K32.AssignProcessToJobObject(job, wintypes.HANDLE(int(proc._handle))):
            raise ctypes.WinError(ctypes.get_last_error())
        assigned = True
        reader = threading.Thread(target=read_stdout, daemon=True)
        monitor = threading.Thread(target=sample, daemon=True)
        reader.start()
        monitor.start()
        status = job_api.NTDLL.NtResumeProcess(wintypes.HANDLE(int(proc._handle)))
        if status != 0:
            raise RuntimeError(f'NtResumeProcess failed: {status:#x}')
        while proc.poll() is None:
            if errors:
                raise RuntimeError('; '.join(errors))
            if time.monotonic() - started > timeout:
                raise TimeoutError('benchmark exceeded fixed wall timeout')
            time.sleep(0.25)
        trace['exit_code'] = proc.returncode
        if proc.returncode != 0:
            raise RuntimeError(f'benchmark exited {proc.returncode}')
        if not job_api.wait_job_empty(job, seconds=30):
            raise RuntimeError('job still contains a child after benchmark exit')
        trace['job_empty'] = True
    except Exception as exc:
        trace['reason'] = repr(exc)
        if assigned:
            job_api.terminate_job(job, trace)
        elif proc is not None:
            proc.kill()
            proc.wait(timeout=30)
        raise
    finally:
        stop.set()
        if monitor:
            monitor.join(timeout=10)
        if reader:
            reader.join(timeout=10)
        if (monitor and monitor.is_alive()) or (reader and reader.is_alive()):
            errors.append('monitor or reader failed to stop')
        job_api.K32.CloseHandle(job)
        trace['ended_at'] = now()
        trace['wall_seconds'] = time.monotonic() - started
        trace['observer_errors'] = errors
        (folder / 'stdout.log').write_bytes(output)
        dump_new(folder / 'stdout_events.json', line_events)
        dump_new(folder / 'telemetry.json', telemetry)
        dump_new(folder / 'process.json', trace)
    if errors:
        raise RuntimeError('observer failed: ' + repr(errors))
    return line_events


def summarize(values):
    mean = statistics.mean(values)
    return {'n': len(values), 'samples': values, 'mean': mean,
            'median': statistics.median(values),
            'sample_stddev': statistics.stdev(values) if len(values) > 1 else None,
            'sample_cv': statistics.stdev(values) / mean if len(values) > 1 and mean else None}


def review_run(raw_path, condition, events):
    data = json.loads(raw_path.read_text(encoding='utf-8'))
    expected_queries = 20000 if condition == 'A' else 80000
    points = data['measurements']
    if (data.get('dim') != 768 or data.get('n_train') != 1000000 or
        data.get('n_test') != expected_queries or
        data['parameters']['m'] != 32 or data['parameters']['ef_construction'] != 128 or
        [p['ef_search'] for p in points] != EF_SEQUENCE):
        raise ValueError('raw benchmark parameters, sizes, or ordered ef sequence differ')
    if [e['ef'] for e in events] != EF_SEQUENCE:
        raise ValueError('timestamped stdout ef lines are missing or out of order')
    groups = {str(ef): [] for ef in EFS}
    for index, point in enumerate(points):
        qps, recall = point['qps'], point['recall_at_10']
        if not math.isfinite(qps) or qps <= 0 or not 0 <= recall <= 1:
            raise ValueError('invalid query batch measurement')
        ef = point['ef_search']
        groups[str(ef)].append({'ordinal': index // len(EFS) + 1,
                                'warmup': index < len(EFS), 'qps': qps,
                                'recall_at_10': recall, 'derived_elapsed_seconds_from_qps': expected_queries / qps,
                                'stdout_arrival_utc': events[index]['arrival_utc'],
                                'stdout_arrival_monotonic': events[index]['monotonic_seconds']})
    stats = {}
    for ef, records in groups.items():
        stats[ef] = {'all': summarize([x['qps'] for x in records]),
                     'after_first_warmup': summarize([x['qps'] for x in records[1:]]),
                     'batches': records}
    return {'condition': condition, 'queries': expected_queries,
            'build_seconds': data['build']['seconds'], 'ef_results': stats}


def preregistration():
    return {'status': 'diagnostic_only', 'performance_publishable': False,
            'formal_protocol_modified': False, 'accepted_into_official_results': False,
            'created_at': now(), 'sequence': SEQUENCE, 'condition_A_queries': 20000,
            'condition_B_queries': 80000, 'condition_B': 'four byte-exact repetitions of A; not 80,000 unique queries',
            'ef_sequence': EF_SEQUENCE, 'ef_set': EFS, 'repeats_per_ef_per_index': REPEATS,
            'first_occurrence': 'pre-registered warmup, recorded and analyzed both included and excluded',
            'threads': 16, 'm': 32, 'ef_construction': 128, 'revision': REVISION,
            'fixed_index_scope': 'one build per process, all repeated ef batches on that same index',
            'window_comparison_limit': 'A and B use different independently built indexes; window, cache, build, order and temperature may be confounded',
            'statistics': 'per-index sample CV (n-1) by ef, with and without first warmup; across-index CV of per-index medians; no threshold changes or selected best samples',
            'elapsed_limit': 'Rust JSON supplies QPS and latency, not raw elapsed seconds; elapsed in review.json is derived as query_count / QPS',
            'telemetry_limit': 'one-second total CPU includes benchmark; Job CPU/I/O cumulative; stdout arrival times approximate batch-end markers and may be buffered',
            'sensor_limit': 'optional raw ACPI zones may be unavailable/uncalibrated; frequency/clock counters may not reflect instantaneous core frequency; missing readings are recorded, not guessed',
            'observer_limit': 'wall duration includes intentional CPU sampling wait; observer process CPU delta includes all Python threads, not just the monitor',
            'timeout_seconds_per_process': 1800,
            'failure_policy': 'stop on first validation, integrity, supervision, or timeout; retain all partial records; optional sensor unavailability is recorded; no retry or cherry-picking'}


def self_test():
    temp = Path(tempfile.mkdtemp(prefix='tdb-query-diagnostic-smoke-'))
    a = temp / 'a.bin'
    b = temp / 'b.bin'
    a.write_bytes(b'0123456789' * 31)
    expected = sha256(a)
    result = make_repeated(a, b, 4, expected)
    assert result['bytes'] == a.stat().st_size * 4
    assert result['segment_sha256'] == [expected] * 4
    try:
        make_repeated(a, b, 4, expected)
    except FileExistsError:
        pass
    else:
        raise AssertionError('exclusive input creation failed')
    verify_generated(temp, {'synthetic': result})
    with b.open('ab') as out:
        out.write(b'changed')
    try:
        verify_generated(temp, {'synthetic': result})
    except RuntimeError:
        pass
    else:
        raise AssertionError('changed generated input unexpectedly accepted')
    stats = summarize([10, 11, 12])
    assert stats['n'] == 3 and abs(stats['sample_stddev'] - 1) < 1e-12
    code_expected = {'fixture': sha256(a)}
    verify_code({'fixture': a}, code_expected)
    with a.open('ab') as out:
        out.write(b'changed')
    try:
        verify_code({'fixture': a}, code_expected)
    except RuntimeError:
        pass
    else:
        raise AssertionError('changed code fixture unexpectedly accepted')
    sensor_sample = sensors()
    assert 'wall_seconds' in sensor_sample and ('raw_stdout' in sensor_sample or 'error' in sensor_sample)
    folder = temp / 'process'
    folder.mkdir()
    code = "import time; print('ef=10 test', flush=True); time.sleep(1); print('ef=25 test', flush=True)"
    events = monitored_process([sys.executable, '-u', '-c', code], ROOT, os.environ.copy(), folder, 30)
    assert [x['ef'] for x in events] == [10, 25]
    assert json.loads((folder / 'process.json').read_text(encoding='utf-8'))['job_empty']
    timeout_folder = temp / 'timeout-smoke'
    timeout_folder.mkdir()
    child_code = ("import subprocess,sys,time; "
                  "subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)']); "
                  "print('spawned child',flush=True); time.sleep(60)")
    try:
        monitored_process([sys.executable, '-u', '-c', child_code], ROOT,
                          os.environ.copy(), timeout_folder, 2)
    except TimeoutError:
        pass
    else:
        raise AssertionError('timeout did not fail')
    timeout_trace = json.loads((timeout_folder / 'process.json').read_text(encoding='utf-8'))
    assert b'spawned child' in (timeout_folder / 'stdout.log').read_bytes()
    assert timeout_trace['termination_confirmed'] and timeout_trace['active_after_termination'] == 0
    assert 'TimeoutError' in timeout_trace['reason']
    failure_folder = temp / 'monitor-failure-smoke'
    failure_folder.mkdir()
    old_cpu_percent = runner.cpu_percent
    def inject_monitor_failure(_seconds=1):
        raise RuntimeError('synthetic monitor failure')
    try:
        runner.cpu_percent = inject_monitor_failure
        try:
            monitored_process([sys.executable, '-u', '-c', 'import time; time.sleep(60)'],
                              ROOT, os.environ.copy(), failure_folder, 30)
        except RuntimeError as exc:
            assert 'synthetic monitor failure' in str(exc)
        else:
            raise AssertionError('monitor failure did not fail')
    finally:
        runner.cpu_percent = old_cpu_percent
    failure_trace = json.loads((failure_folder / 'process.json').read_text(encoding='utf-8'))
    assert failure_trace['termination_confirmed'] and failure_trace['active_after_termination'] == 0
    assert any('synthetic monitor failure' in item for item in failure_trace['observer_errors'])
    points = [{'ef_search': ef, 'qps': 50000.0 + i, 'recall_at_10': .9} for i, ef in enumerate(EF_SEQUENCE)]
    raw = temp / 'fake-result.json'
    dump_new(raw, {'dim': 768, 'n_train': 1000000, 'n_test': 20000,
                   'parameters': {'m': 32, 'ef_construction': 128},
                   'build': {'seconds': 1}, 'measurements': points})
    synthetic = [{'ef': ef, 'arrival_utc': now(), 'monotonic_seconds': float(i)} for i, ef in enumerate(EF_SEQUENCE)]
    review = review_run(raw, 'A', synthetic)
    assert review['ef_results']['10']['all']['n'] == REPEATS
    assert review['ef_results']['10']['after_first_warmup']['n'] == REPEATS - 1
    synthetic[0]['ef'] = 999
    try:
        review_run(raw, 'A', synthetic)
    except ValueError:
        pass
    else:
        raise AssertionError('invalid ef output unexpectedly accepted')
    # Exercise the real, unchanged Rust executable with genuinely tiny,
    # synthetic data. No official dataset or performance result is used.
    import numpy as np
    source = json.loads(SOURCE.read_text(encoding='utf-8'))
    exe = WORKTREE / 'target' / 'release' / 'deps' / source['benchmark_executable']['file']
    if sha256(exe) != source['benchmark_executable']['sha256']:
        raise RuntimeError('smoke binary differs from the previously recorded executable')
    rng = np.random.default_rng(2718)
    train = rng.standard_normal((1000, 768), dtype=np.float32)
    queries = rng.standard_normal((12, 768), dtype=np.float32)
    normalized_train = train / np.linalg.norm(train, axis=1, keepdims=True)
    normalized_queries = queries / np.linalg.norm(queries, axis=1, keepdims=True)
    scores = normalized_queries @ normalized_train.T
    ground_truth = np.argsort(-scores, axis=1)[:, :10].astype(np.int32)
    train_path, query_path, gt_path = temp / 'train.f32', temp / 'query.f32', temp / 'gt.i32'
    train.tofile(train_path)
    queries.tofile(query_path)
    ground_truth.tofile(gt_path)
    rust_folder = temp / 'rust-smoke'
    rust_folder.mkdir()
    rust_raw = rust_folder / 'benchmark.json'
    smoke_efs = [10, 25, 10, 25]
    env = {k: v for k, v in os.environ.items() if not k.upper().startswith('TRIVIUM_')}
    env.update({'RAYON_NUM_THREADS': '16', 'TRIVIUM_MT_THREADS': '16',
                'TRIVIUM_ANN_NAME': 'cohere-1m', 'TRIVIUM_ANN_DIM': '768',
                'TRIVIUM_ANN_TRAIN': str(train_path), 'TRIVIUM_ANN_TEST': str(query_path),
                'TRIVIUM_ANN_GT': str(gt_path), 'TRIVIUM_ANN_EF': ','.join(map(str, smoke_efs)),
                'TRIVIUM_ANN_M': '32', 'TRIVIUM_ANN_EF_CONSTRUCTION': '128',
                'TRIVIUM_RESULT_PATH': str(rust_raw)})
    rust_events = monitored_process([exe], WORKTREE, env, rust_folder, 120)
    rust_data = json.loads(rust_raw.read_text(encoding='utf-8'))
    assert rust_data['n_train'] == 1000 and rust_data['n_test'] == 12
    assert [p['ef_search'] for p in rust_data['measurements']] == smoke_efs
    assert [e['ef'] for e in rust_events] == smoke_efs
    assert json.loads((rust_folder / 'process.json').read_text(encoding='utf-8'))['job_empty']
    dump_new(temp / 'smoke.json', {'status': 'smoke_only', 'performance_publishable': False,
                                  'script_sha256': sha256(Path(__file__)), 'completed_at': now()})
    print(f'self-test passed; diagnostic only: {temp}', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--self-test', action='store_true')
    parser.add_argument('--output', help='new directory under results/bench-090')
    parser.add_argument('--max-wait', type=int, default=1800)
    args = parser.parse_args()
    if args.self_test:
        return self_test()
    if os.name != 'nt' or not args.output:
        parser.error('Windows and --output are required for diagnostic collection')
    if args.max_wait < 1:
        parser.error('--max-wait must be positive')
    out = Path(args.output).resolve()
    if out == RESULT_ROOT or not out.is_relative_to(RESULT_ROOT) or out.exists():
        parser.error('--output must name a new directory below results/bench-090')
    # Snapshot as early as possible, before any full-file hashing or dataset
    # generation. Python has already imported the script, so the bytes read
    # here cannot cryptographically prove what the interpreter loaded before
    # main(); preserve and disclose that narrow startup limitation.
    startup_bytes = Path(__file__).read_bytes()
    startup_hash = hashlib.sha256(startup_bytes).hexdigest()
    out.mkdir(parents=True, exist_ok=False)
    with (out / 'script_snapshot.py').open('xb') as snapshot:
        snapshot.write(startup_bytes)
    dump_new(out / 'preregistration.json', preregistration())
    source = json.loads(SOURCE.read_text(encoding='utf-8'))
    hashes = json.loads(BOUND_HASHES.read_text(encoding='utf-8'))['cohere-1m']
    prior = BOUND_HASHES.parent
    prior_manifest_path = prior / 'manifest.json'
    prior_manifest = json.loads(prior_manifest_path.read_text(encoding='utf-8'))
    gt_log, gt_meta = prior / 'groundtruth-check.log', prior / 'groundtruth-check.meta.json'
    identity_path = prior / 'groundtruth-check.identity.json'
    identity = json.loads(identity_path.read_text(encoding='utf-8'))
    meta = json.loads(gt_meta.read_text(encoding='utf-8'))
    log_text = gt_log.read_text(encoding='utf-8')
    prior_hashes = [json.loads((prior / name).read_text(encoding='utf-8'))['cohere-1m']
                    for name in ('input_hashes_before.json', 'input_hashes_after_preflight.json', 'input_hashes_after.json')]
    if (sha256(SOURCE) != prior_manifest['source_manifest_sha256'] or
        sha256(gt_log) != identity['log_sha256'] or sha256(gt_meta) != identity['meta_sha256'] or
        meta.get('exit_code') != 0 or not meta.get('all_checks_ok') or
        not re.search(r'^\s*cohere-1m\s+gt_match=1\.0000\s+.*\[OK\]', log_text, re.MULTILINE) or
        not all(item == hashes for item in prior_hashes)):
        raise RuntimeError('prior ground-truth preflight or input binding cannot be verified')
    dump_new(out / 'groundtruth_binding.json', {'source': str(prior),
             'preflight_log_sha256': identity['log_sha256'], 'preflight_meta_sha256': identity['meta_sha256'],
             'check': 'cohere-1m sampled gt_match=1.0000; x80 is four byte-identical x20 copies',
             'limitation': 'the historical preflight is sampled, not exhaustive; boundary hashes cannot exclude changes reverted between snapshots'})
    if runner.old.worktree_rev() != REVISION:
        raise RuntimeError('benchmark worktree revision changed')
    exe = WORKTREE / 'target' / 'release' / 'deps' / source['benchmark_executable']['file']
    if sha256(exe) != source['benchmark_executable']['sha256']:
        raise RuntimeError('benchmark executable differs from source replay')
    code_paths = {'script': Path(__file__), 'runner': Path(runner.__file__),
                  'bench_runner': Path(runner.old.__file__), 'report_helper': Path(runner.report.__file__),
                  'job_supervisor': Path(job_api.__file__), 'executable': exe,
                  'bench_source': WORKTREE / 'benches' / 'bench_cohere1m.rs',
                  'cargo_lock': WORKTREE / 'Cargo.lock', 'source_manifest': SOURCE,
                  'v3_manifest': prior_manifest_path, 'prior_input_hashes': BOUND_HASHES,
                  'gt_log': gt_log, 'gt_meta': gt_meta, 'gt_identity': identity_path}
    source_hashes = {key: sha256(path) for key, path in code_paths.items()}
    diff_hash = worktree_diff_hash()
    if (source_hashes['script'] != startup_hash or
        source_hashes['runner'] != source['runner_sha256'] or
        source_hashes['bench_runner'] != source['bench090_script_sha256'] or
        source_hashes['report_helper'] != source['report090_script_sha256'] or
        source_hashes['job_supervisor'] != prior_manifest['continuation_script_sha256'] or
        source_hashes['bench_source'] != source['bench_source_sha256'] or
        source_hashes['cargo_lock'] != source['cargo_lock_sha256'] or
        diff_hash != source['worktree_diff_sha256']):
        raise RuntimeError('benchmark, dependencies, worktree patch, or startup snapshot differs from bound replay')
    dump_new(out / 'code_identity.json', {'sha256': source_hashes, 'worktree_diff_sha256': diff_hash,
             'script_snapshot_file': 'script_snapshot.py',
             'startup_limit': 'snapshot was taken at entry to main after Python imported source; exact previously loaded bytes cannot be independently verified'})
    inputs = {'train': ROOT / 'cohere_train.f32', 'queries': ROOT / 'cohere_test_x20.f32',
              'ground_truth': ROOT / 'cohere_groundtruth_x20.i32'}
    before = {k: describe(v) for k, v in inputs.items()}
    for key, data in before.items():
        if data['sha256'] != hashes[key]['sha256'] or data['bytes'] != hashes[key]['bytes']:
            raise RuntimeError(f'input differs from completed replay: {key}')
    if before['queries']['bytes'] != 20000 * 768 * 4 or before['ground_truth']['bytes'] % (20000 * 4):
        raise RuntimeError('unexpected source query or ground-truth dimensions')
    dump_new(out / 'inputs_before.json', before)
    data_dir = out / 'diagnostic-inputs-local-only'
    data_dir.mkdir()
    repeated = {'queries': make_repeated(inputs['queries'], data_dir / 'cohere_test_x80.f32', 4, before['queries']['sha256']),
                'ground_truth': make_repeated(inputs['ground_truth'], data_dir / 'cohere_groundtruth_x80.i32', 4, before['ground_truth']['sha256'])}
    dump_new(out / 'diagnostic_inputs.json', repeated)
    verify_code(code_paths, source_hashes)
    if worktree_diff_hash() != diff_hash:
        raise RuntimeError('worktree patch changed during input generation')
    runs = []
    for ordinal, condition in enumerate(SEQUENCE, 1):
        folder = out / f'run-{ordinal:02}-{condition}'
        folder.mkdir()
        verify_code(code_paths, source_hashes)
        if worktree_diff_hash() != diff_hash:
            raise RuntimeError('worktree patch changed before diagnostic run')
        if condition == 'B':
            dump_new(folder / 'generated_input_before.json', verify_generated(data_dir, repeated))
        dump_new(folder / 'sensors_before.json', sensors())
        resource_gate(folder / 'gate.jsonl', before['train']['bytes'], args.max_wait)
        raw = folder / 'benchmark.json'
        query = inputs['queries'] if condition == 'A' else data_dir / 'cohere_test_x80.f32'
        gt = inputs['ground_truth'] if condition == 'A' else data_dir / 'cohere_groundtruth_x80.i32'
        env = {k: v for k, v in os.environ.items() if not k.upper().startswith('TRIVIUM_')}
        env.update({'RAYON_NUM_THREADS': '16', 'TRIVIUM_MT_THREADS': '16',
                    'TRIVIUM_ANN_NAME': 'cohere-1m', 'TRIVIUM_ANN_DIM': '768',
                    'TRIVIUM_ANN_TRAIN': str(inputs['train']), 'TRIVIUM_ANN_TEST': str(query),
                    'TRIVIUM_ANN_GT': str(gt), 'TRIVIUM_ANN_EF': ','.join(map(str, EF_SEQUENCE)),
                    'TRIVIUM_ANN_M': '32', 'TRIVIUM_ANN_EF_CONSTRUCTION': '128',
                    'TRIVIUM_RESULT_PATH': str(raw)})
        dump_new(folder / 'config.json', {'condition': condition, 'ordinal': ordinal,
                 'env_overrides': {k: v for k, v in env.items() if k.startswith('TRIVIUM_') or k == 'RAYON_NUM_THREADS'},
                 'status': 'diagnostic_only'})
        print(f'[{now()}] diagnostic run {ordinal}/{len(SEQUENCE)} condition {condition}', flush=True)
        events = monitored_process([exe], WORKTREE, env, folder, 1800)
        dump_new(folder / 'sensors_after.json', sensors())
        verify_code(code_paths, source_hashes)
        if worktree_diff_hash() != diff_hash:
            raise RuntimeError('worktree patch changed after diagnostic run')
        if condition == 'B':
            dump_new(folder / 'generated_input_after.json', verify_generated(data_dir, repeated))
        result = review_run(raw, condition, events)
        result['ordinal'] = ordinal
        dump_new(folder / 'review.json', result)
        runs.append(result)
    after = {k: describe(v) for k, v in inputs.items()}
    dump_new(out / 'inputs_after.json', after)
    if before != after:
        raise RuntimeError('source input hash, size, or mtime changed during diagnostic')
    dump_new(out / 'diagnostic_inputs_after.json', verify_generated(data_dir, repeated))
    verify_code(code_paths, source_hashes)
    if worktree_diff_hash() != diff_hash:
        raise RuntimeError('worktree patch changed during diagnostic')
    comparisons = {}
    for condition in ['A', 'B']:
        group = [run for run in runs if run['condition'] == condition]
        comparisons[condition] = {}
        for ef in map(str, EFS):
            medians = [run['ef_results'][ef]['after_first_warmup']['median'] for run in group]
            comparisons[condition][ef] = {'across_independent_build_medians': summarize(medians),
                                           'within_index_cv': [run['ef_results'][ef]['after_first_warmup']['sample_cv'] for run in group]}
    dump_new(out / 'summary.json', {'status': 'diagnostic_only', 'performance_publishable': False,
             'completed_at': now(), 'comparisons': comparisons,
             'limitations': preregistration()['window_comparison_limit']})
    print(f'[{now()}] completed diagnostic only: {out}', flush=True)


if __name__ == '__main__':
    main()
